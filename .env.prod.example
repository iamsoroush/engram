# Production environment — copy to `.env.prod`, fill in the secrets, and NEVER commit `.env.prod`.
# Generate the strong secrets with: scripts/gen-secrets.sh
# Used by: docker compose -f docker-compose.prod.yml -f docker-compose.prod.tls.yml --env-file .env.prod ...

# --- Domain / TLS edge (Caddy) ------------------------------------------------------------------
# The hostname Caddy serves + auto-certs. Behind ArvanCloud CDN, use a DIRECT origin hostname
# (e.g. origin.example.com, A-record straight to the VPS); without a CDN, your main app hostname
# (e.g. app.example.com) — that hostname must resolve to the VPS during cert issuance.
CADDY_SITE_ADDRESS=app.example.com
# Keep the frontend off host :80 so Caddy can own it (Caddy reaches it internally as frontend:80).
PROD_FRONTEND_PORT=127.0.0.1:8080
# Same-origin API: leave empty so the browser calls /api/v1 and nginx proxies to the backend.
PROD_VITE_API_URL=

# --- Core secrets (generate! scripts/gen-secrets.sh) -------------------------------------------
POSTGRES_DB=engram
POSTGRES_USER=engram
POSTGRES_PASSWORD=CHANGES_ME_generate
MINIO_ROOT_USER=engram-prod
MINIO_ROOT_PASSWORD=CHANGES_ME_generate
BACKEND_JWT_SECRET=CHANGES_ME_generate
AI_ENGINE_INTERNAL_TOKEN=CHANGES_ME_generate

# --- Backend ----------------------------------------------------------------------------------
BACKEND_APP_NAME=Engram API
BACKEND_AUTH_MODE=production                       # MUST be 'production' — disables dev-login
BACKEND_CORS_ORIGINS=["https://app.example.com"]   # your public app origin(s)
BACKEND_DATABASE_URL=postgresql+psycopg://engram:CHANGES_ME_generate@postgres:5432/engram  # match POSTGRES_*

# --- Object storage --------------------------------------------------------------------------
# Option A (self-hosted MinIO, the default stack): point at the internal minio service.
# Option B (recommended at scale): ArvanCloud S3 — set ENDPOINT/PUBLIC_ENDPOINT to the Arvan
# endpoint, SECURE=true, and use an app-scoped access key limited to the bucket.
BACKEND_OBJECT_STORAGE_ENDPOINT=http://minio:9000
BACKEND_OBJECT_STORAGE_PUBLIC_ENDPOINT=          # public base for presigned URLs (e.g. https://media.example.com); empty = same as endpoint
BACKEND_OBJECT_STORAGE_BUCKET=engram-captures
BACKEND_OBJECT_STORAGE_ACCESS_KEY=CHANGES_ME_app_scoped   # NOT the MinIO root user in prod
BACKEND_OBJECT_STORAGE_SECRET_KEY=CHANGES_ME_app_scoped
BACKEND_OBJECT_STORAGE_SECURE=false              # true when using an https endpoint (ArvanCloud S3)
BACKEND_OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=300

# --- Celery / Redis --------------------------------------------------------------------------
BACKEND_CELERY_BROKER_URL=redis://redis:6379/0
BACKEND_CELERY_RESULT_BACKEND=redis://redis:6379/1
BACKEND_AI_JOB_MAX_RETRIES=3
BACKEND_AI_JOB_RETRY_DELAY_SECONDS=30

# --- AI engine (gateway in Europe, reachable from Iran) --------------------------------------
AI_ENGINE_BACKEND_INTERNAL_URL=http://backend:8000
AI_ENGINE_TRANSCRIPTION_BASE_URL=https://your-eu-gateway.example/v1
AI_ENGINE_TRANSCRIPTION_API_KEY=CHANGES_ME
AI_ENGINE_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite

# --- Pro AI (report synthesis + captions + patient memory) -----------------------------------
# Synthesis is OFF by default — set ENABLED=true + a synthesis model to get Pro synthesized reports.
# Caption / patient-memory left blank fall back to the (multimodal) transcription model above; the
# base_url/api_key also reuse the transcription gateway, so on a single gateway you only set models.
BACKEND_REPORT_SYNTHESIS_ENABLED=true
AI_ENGINE_REPORT_SYNTHESIS_MODEL=gpt-5.4-nano
AI_ENGINE_REPORT_SYNTHESIS_REASONING_EFFORT=low
AI_ENGINE_CAPTION_MODEL=
AI_ENGINE_PATIENT_MEMORY_MODEL=

# --- Backups (scripts/backup.sh) -------------------------------------------------------------
BACKUP_DIR=/var/backups/engram
BACKUP_RETAIN_DAYS=14
# Encrypt dumps at rest (AES-256) before they leave the box. Generate with scripts/gen-secrets.sh and
# STORE IT SEPARATELY from the backups (lose the key = unrecoverable backups). Empty = unencrypted (not for PHI).
BACKUP_ENCRYPTION_KEY=
# Off-box copy target: an `mc` alias name you configure on the host pointing at ArvanCloud S3,
# plus the destination bucket. Leave OFFSITE_ALIAS empty to skip the off-box push (NOT recommended).
OFFSITE_ALIAS=
OFFSITE_BUCKET=engram-backups

# --- Monitoring overlay (docker-compose.monitoring.yml; see docs/monitoring.md) ---------------
# Required when running the monitoring overlay (generate with scripts/gen-secrets.sh):
GRAFANA_ADMIN_PASSWORD=CHANGES_ME_generate
GLITCHTIP_SECRET_KEY=CHANGES_ME_generate
GLITCHTIP_POSTGRES_PASSWORD=CHANGES_ME_generate
# Optional: GRAFANA_ADMIN_USER, GRAFANA_ROOT_URL, PROMETHEUS_RETENTION, GLITCHTIP_DOMAIN, … (docs/monitoring.md)
# Error-tracking DSNs — fill after the first GlitchTip login, then redeploy backend + frontend:
# BACKEND_SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- Build (optional; Iran) ---
# pip index for in-country Docker builds — PyPI/Fastly is flaky/blocked from Iran. Unset = pypi.org.
# PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
