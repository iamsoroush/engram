*.pid

# Local prototype uploads
captures/

# AI eval fixtures: capture media (audio/photos) + their expectation .json are PII and live in object
# storage / a local staging dir, never in git. Keep only the dir scaffolding + the recording checklist.
apps/ai_engine/eval/fixtures/*/*
!apps/ai_engine/eval/fixtures/*/.gitkeep
# Local cache populated by `scripts/eval-fixtures.sh pull`.
.eval-fixtures-cache/
# Machine-readable eval scorecards (run artifacts): per-module + merged JSON written by
# _common.write_scorecard / run_all.py. Trend history is archived to object storage, never git.
apps/ai_engine/eval/out/

# Notebooks
notebooks/

# Assets
design/
apps/frontend/tsconfig.tsbuildinfo

# Build-loop scratch workspace (ephemeral per-run artifacts: stories, DoD
# contracts, evaluator verdicts, decision log). Durable outcomes get reconciled
# into docs/ at close-out; the scaffolding itself stays untracked.
.loop/
deploy/certs/
