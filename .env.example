BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
FRONTEND_PORT=5183
VITE_API_URL=http://localhost:8010/api/v1
# Comma-separated hosts allowed by the Vite dev server, for HTTPS tunnels such as ngrok.
# Example: VITE_ALLOWED_HOSTS=example.ngrok-free.dev
VITE_ALLOWED_HOSTS=
BACKEND_CORS_ORIGINS=["http://localhost:5183"]
BACKEND_AUTH_MODE=dev
BACKEND_JWT_SECRET=dev-only-change-me
POSTGRES_DB=aesmem
POSTGRES_USER=aesmem
POSTGRES_PASSWORD=aesmem
POSTGRES_PORT=5442
REDIS_PORT=6389
MINIO_ROOT_USER=aesmem-dev
MINIO_ROOT_PASSWORD=aesmem-dev-secret
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
BACKEND_DATABASE_URL=postgresql+psycopg://aesmem:aesmem@postgres:5432/aesmem
BACKEND_OBJECT_STORAGE_ENDPOINT=http://minio:9000
BACKEND_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9010
BACKEND_OBJECT_STORAGE_BUCKET=aesmem-captures
BACKEND_OBJECT_STORAGE_ACCESS_KEY=aesmem-dev
BACKEND_OBJECT_STORAGE_SECRET_KEY=aesmem-dev-secret
BACKEND_OBJECT_STORAGE_SECURE=false
BACKEND_OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=300

# Production
BACKEND_APP_NAME=AesMem API
BACKEND_CORS_ORIGINS=["http://localhost"]
PROD_FRONTEND_PORT=80
PROD_VITE_API_URL=
